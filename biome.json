{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"scripts/fork-release-signers.test.mjs",
			"scripts/worktree.mjs",
			"scripts/worktree.test.mjs",
			"scripts/binary-release-contract.mjs",
			"scripts/binary-release-contract.test.mjs",
			"scripts/binary-release-workflow.test.mjs",
			"scripts/smoke-test-memory-binary.mjs",
			"scripts/smoke-test-memory-binary.test.mjs",
			"scripts/resource-loader-home.test.ts",
			"scripts/project-skill-admission.test.ts",
			"scripts/resource-home-guard.ts",
			"scripts/resource-home-guard.bun.mjs",
			"scripts/model-catalog-protocol.ts",
			"scripts/model-catalog-protocol.test.ts",
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"packages/agent/examples/**/*.ts",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules",
			"!!apps"
		]
	},
	"plugins": ["./scripts/biome/model-type-comparison.grit"]
}
